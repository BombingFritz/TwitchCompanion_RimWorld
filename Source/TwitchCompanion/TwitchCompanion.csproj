<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld-Mod. RICS wird nicht referenziert, sondern zur Laufzeit per Reflexion gefunden (Spec, „Einstiegspunkte und Patches“). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TwitchCompanion.RimWorld</AssemblyName>
    <RootNamespace>TwitchCompanion.RimWorld</RootNamespace>
    <Version>0.1.0</Version>
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
